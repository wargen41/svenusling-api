{% if pop_id == null %}
        <pre>ERROR pop_id is null</pre>
{% else %}
        <dialog id="{{ pop_id }}" popover class="pseudo-modal">
            <header>
                <nav>
                    <button popovertarget="{{ pop_id }}" popovertargetaction="hide"><span aria-hidden="true">×</span></button>
                </nav>
            </header>
            <div class="content">
{% block content %}{% endblock %}
            </div>
        </dialog>
{% endif %}
