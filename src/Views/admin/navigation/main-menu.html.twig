<nav popover class="main menu" id="main-menu">
    <header>
        <nav>
            <button popovertarget="main-menu" popovertargetaction="hide"><span aria-hidden="true">×</span></button>
        </nav>
        {#<h2>Sven Admin</h2>#}
    </header>
    <section class="content">
        <form style="display:none;" action="search.php" method="get">
            <input type="search" id="main-menu-search-input" required name="query" value="">
            <button type="submit">Sök</button>
        </form>

        {% macro render_submenus(nav_cat, parent_id) %}
        {% for nav_item in nav_cat.items %}
        {% set submenu_id = parent_id ~ '-' ~ loop.index %}
        <li>
            {% if nav_item.href %}

            {% if nav_item.inactive != true %}
                <a class="button" href="{{ nav_item.href }}"{% if nav_item.target is defined %} target="{{ nav_item.target }}"{% endif %}>{{ nav_item.label }}</a>
            {% else %}
               <button>{{ nav_item.label }}</button>
            {% endif %}

            {% else %}
                <button type="button" popovertarget="{{ submenu_id }}" style="anchor-name:--{{ submenu_id }}">{{ nav_item.label }}</button>
                {% if nav_item.items is defined %}
                <nav popover class="sub menu"
                    id="{{ submenu_id }}"
                    style="position-anchor: --{{ submenu_id }};"
                >
                    <header>
                        <nav>
                            <button popovertarget="main-menu" popovertargetaction="hide"><span aria-hidden="true">×</span></button>
                            <label for="{{ submenu_id }}-back">{{ nav_item.label }}</label>
                            <button id="{{ submenu_id }}-back" popovertarget="{{ submenu_id }}" popovertargetaction="hide"><span aria-hidden="true">&lt;</span></button>
                        </nav>
                    </header>
                    <section class="content">
                        <ul>
                        {{ _self.render_submenus(nav_item, submenu_id) }}
                        </ul>
                    </section>
                </nav>
                {% endif %}
            {% endif %}
        </li>
        {% endfor %}
        {% endmacro %}

        <ul>
            {% for nav_key, nav_cat in nav_list %}
            <li>{{ nav_key }}
                <ul>
                    {{ _self.render_submenus(nav_cat, 'menu-' ~ loop.index) }}
                </ul>
            </li>
            {% endfor %}
            <li class="user"></li>
        </ul>
    </section>
    <footer>
        <div class="user">
            <p>Inloggad som {{ user.username }} <a class="button" href="/admin/logout">Logga ut</a></p>
        </div>
    </footer>
</nav>
